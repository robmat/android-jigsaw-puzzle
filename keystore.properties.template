## ../keystore.properties (one folder up, shared across all game projects in
## this workspace — gitignored, never committed).
## storeFile is resolved relative to THIS project's root, not the shared folder.
##
## Note: this is separate from this project's own local keystore.properties
## used by the pre-existing prodSigned/debugProdSigned signing config below -
## that one stays project-local and is unrelated to the shared secrets here.
storeFile=../dev_keystore.jks
storePassword=
keyAlias=
keyPassword=
